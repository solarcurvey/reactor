{
  "name": "reactor",
  "version": "0.3.3",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "web": "pnpm --filter web dev --port 43147",
    "indexer": "pnpm --filter indexer dev",
    "demo": "pnpm --filter indexer demo",
    "test:web": "pnpm --filter web test",
    "docs:gen": "tsx scripts/sync-docs.ts generate",
    "docs:check": "tsx scripts/sync-docs.ts check",
    "size:guard": "tsx scripts/size-guard.ts",
    "arc:factory-attempt": "tsx scripts/arc-factory-deploy.ts",
    "safe:genesis": "tsx scripts/safe-genesis-builder.ts",
    "test:lib": "pnpm --filter indexer test && tsx apps/web/src/lib/top10.test.ts && tsx apps/web/src/lib/marketdata.test.ts && tsx scripts/sync-docs.ts check",
    "signer": "pnpm --filter indexer signer"
  },
  "devDependencies": {
    "tsx": "^4.20.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["sharp"]
  }
}
