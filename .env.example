# Local Arc-compatible anvil (default demo)
NEXT_PUBLIC_CHAIN_ID=5042002
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_EXPLORER_URL=https://testnet.arcscan.app
NEXT_PUBLIC_WALLETCONNECT_ID=

# Optional live Arc Testnet (do not claim success unless txs land here)
# NEXT_PUBLIC_RPC_URL=https://rpc.testnet.arc.io
# ARC_TESTNET_RPC=https://rpc.testnet.arc.io

# Foundry
DEPLOYER_PK=
# Anvil account 0 (public, local only):
# DEPLOYER_PK=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

INDEXER_PORT=43148
# Public JSON POSTs (/quote, /launch/admit, /launch/authorize) stream-cap.
# Default 16384. Hard maximum 65536 — higher values are clamped (a typo cannot disable the cap).
# JSON_BODY_LIMIT_BYTES=16384
INDEXER_DB=./apps/indexer/data/reactor.sqlite
# Production: DATABASE_URL=postgres://user:pass@host:5432/reactor
WEB_PORT=43147
# LOCAL keeps Turnstile / Anvil / inline-signer bypasses.
# PROD (or NODE_ENV=production) refuses start without Turnstile keys + a non-Anvil PRICING_SIGNER_PK.
REACTOR_ENV=LOCAL
PRICING_SIGNER_URL=http://127.0.0.1:43149
PRICING_SIGNER_PORT=43149
# Never set PRICING_SIGNER_PK in the Next process. Isolated signer only.
# PRICING_SIGNER_PK=
# KEEPER_PRIVATE_KEY=
# Distinct from pricing + Guardian Safe.
# Lease TTL is failover (~50s), not a tick budget. Renew inside the TTL during long ticks.
# KEEPER_LEASE_TTL_MS=50000
# KEEPER_LEASE_RENEW_MS=15000
RPC_URL_FALLBACK=
OPS_TOKEN=
MEDIA_CDN_BASE=
# R2/S3 object key is m/<id>.webp — same path as public uri /m/<id>.webp (MEDIA_CDN_BASE + uri).
# Required outside LOCAL. Widget: NEXT_PUBLIC_TURNSTILE_SITE_KEY. Siteverify: TURNSTILE_SECRET.
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_REQUIRED=
ADMISSION_HMAC_SECRET=
SIGNER_INTERNAL_TOKEN=
SIGNER_INLINE=
ISSUANCE_LEVEL=NORMAL
# External USD marks (canonical address + ≥2 HTTP sources in PROD where available).
# Do not rely on a static dollar outside LOCAL. See apps/indexer/config/price-providers.json
ZEC_ADDRESS=
ZEC_HTTP_URL=
ZEC_HTTP_URL_2=
WBTC_ADDRESS=
WBTC_HTTP_URL=
WBTC_HTTP_URL_2=
# PRICE_PROVIDERS_PATH=
# PRICE_PROVIDERS_JSON=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
# Arc BFT finality is deterministic on commit — default 0 (not eth-8).
ARC_FINALITY_CONFIRMATIONS=0
ARC_TESTNET_RPC=https://rpc.testnet.arc.io
# ARC_TESTNET_PK=   # funded Arc Public Testnet EOA only. Unset → claimed:false (see deployments/arc-testnet-blocker.md)
# Geo policy (#63) — production edge HMAC only. LOCAL uses fixtures (FX/FY) and
# cannot load the production deny revision. Not an HTTP gate (#62).
# GEO_EDGE_SECRET=
# GEO_EDGE_KIND=verified_reverse_proxy
# GEO_EDGE_MAX_SKEW_SEC=90
# GEO_POLICY_ACTIVE=1
# Official-list freshness / policy ops (issue #64). Default SLA is 7 days.
# SANCTIONS_DATA_DIR=./apps/indexer/data/sanctions
# SANCTIONS_OPS_DATA_DIR=./apps/indexer/data/sanctions/ops
# SANCTIONS_MAX_AGE_MS=604800000
# SANCTIONS_REFRESH_INTERVAL_MS=21600000
# SANCTIONS_OPERATED_WRITES=1
# SANCTIONS_INJECT=              # test-only: stale | refresh_fail | policy_fail | partial_refresh
# SANCTIONS_FIXTURE=             # PROD: never set. LOCAL uses fixtures when #61 HTTPS is absent.
# GEO_POLICY_VERSION=us-comprehensive-sanctions.r1
# REDIS_URL=redis://127.0.0.1:6379
# S3_REGION=auto
# USDC_ADDRESS=     # optional funding-parent lookback (first USDC Transfer from)
# Operator policy (#62) — LOCAL fixtures only. Production fail-closes unless #61/#63 plugins bind.
# OPERATOR_POLICY_HMAC_SECRET=   # else ADMISSION_HMAC_SECRET; LOCAL has a demo fallback
# OPERATOR_POLICY_BLOCKED_WALLETS=
# OPERATOR_POLICY_DATASET_FRESHNESS=current
# OPERATOR_POLICY_LOCAL_DEFAULT_GEO=allow
